{
  "info": {
    "_postman_id": "835fc6a0-3c28-48bc-992b-5256e9a80ee9",
    "name": "Sava API",
    "description": "Set variable password before login. POST /transactions creates a permanent sale in the database targeted by base_url; use sava_test for testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "email", "value": "admin@sava.test" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "variant_id", "value": "" },
    { "key": "qty", "value": "1" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login berhasil', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Pilih varian aktif pertama",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Katalog berhasil dimuat', function () { pm.response.to.have.status(200); });",
              "const products = pm.response.json().data || [];",
              "const variant = products.flatMap((product) => product.variants || [])[0];",
              "pm.test('Ada varian aktif', function () { pm.expect(variant).to.exist; });",
              "if (variant) pm.collectionVariables.set('variant_id', String(variant.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Buat satu transaksi kasir (permanen)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"variant_id\":{{variant_id}},\"qty\":{{qty}}}]}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/transactions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Transaksi tersimpan', function () { pm.response.to.have.status(201); });",
              "pm.test('Kode transaksi tersedia', function () { pm.expect(pm.response.json().data.code).to.exist; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard summary",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/dashboard/summary?source=kasir&range=30"
      }
    },
    {
      "name": "Laporan penjualan",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/reports/sales?source=historis&from=2026-05-29&to=2026-11-09"
      }
    },
    {
      "name": "Daftar transaksi laporan",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/reports/transactions?source=historis&from=2026-05-29&to=2026-11-09&per_page=1000"
      }
    },
    {
      "name": "ML evaluation",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/ml/evaluation"
      }
    }
  ]
}
